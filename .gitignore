# ============================================
# 项目特定忽略规则
# ============================================

# 训练输出与日志（不上传）
runs/
logs/
work_dir/
log/

# 模型权重（不上传，体积大；详见 README 中的下载说明）
models/
model/

# IDE / 编辑器
.idea/
.vscode/

# data/ 目录下只保留 .py 脚本
# 思路：先忽略 data 下所有内容，再用 !data/*.py 重新加入 .py 文件
data/**
!data/*.py

# 如果未来在 data 下增加子目录里的脚本，可在这里追加例外：
# !data/<sub_dir>/
# !data/<sub_dir>/*.py

# st_gcn 内部 archive 目录中的旧版本实验代码（视情况保留/排除，默认保留）
# st_gcn/**/archive/

# ============================================
# Python 通用
# ============================================

# 字节码 / 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 打包/分发产物
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# 安装日志
pip-log.txt
pip-delete-this-directory.txt

# 测试 / 覆盖率
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Jupyter
.ipynb_checkpoints

# 环境
.env
.venv
env/
venv/
ENV/

# pyenv
.python-version

# Spyder / Rope
.spyderproject
.spyproject
.ropeproject

# ============================================
# 操作系统 / 临时文件
# ============================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ============================================
# 大体积中间产物（按需排除，主要由上面的 data/、models/ 已覆盖）
# ============================================
*.mp4
*.avi
*.mov

# 注意：故意不全局忽略 *.npy / *.xlsx / *.png / *.csv
#   - test_samples/*.npy   作为 demo 输入需要保留
#   - visualization/*.xlsx 评估结果需要保留
#   - visualization/*.png  实验结果图需要保留
# 如果未来某个目录下产生大量这类临时文件，请在该目录下新增局部 .gitignore
